{
  "requiredFiles": [
    "AGENTS.md",
    "HANDOFF.md",
    "Validation/VerifySource.ps1",
    "ProjectSettings/ProjectVersion.txt",
    "Validation/loop-runtime-compile.rsp",
    "Validation/loop-editor-compile.rsp",
    "Validation/loop-source-tests.runtimeconfig.json"
  ],
  "tools": [
    "powershell.exe",
    "python"
  ],
  "reports": "Validation/harness-runs",
  "wikiHistory": "Documentation/wiki/history.md",
  "buildGuard": "Tools/check_build_identity.py",
  "buildIdentity": "Builds/Windows/build-identity.json",
  "features": {
    "movement": {"checks": ["source", "dice"]},
    "health": {"checks": ["source"], "dependsOn": ["movement"]},
    "replay-online": {"checks": ["source", "front"], "dependsOn": ["health", "movement"]},
    "match-loop": {"checks": ["source", "loop"], "dependsOn": ["health", "movement"]},
    "hud": {"checks": ["front"], "dependsOn": ["health", "movement", "match-loop"]},
    "vision": {"checks": ["source", "vision"]},
    "voice": {"checks": ["source", "front"]},
    "content": {"checks": ["data", "source"]},
    "balance": {"checks": ["balance"], "dependsOn": ["health", "movement"]},
    "build": {"checks": ["data", "build-id", "source", "front", "loop", "dice"]}
  },
  "checks": {
    "balance": {
      "command": ["{python}", "-X", "utf8", "Tools/Balance/run.py", "--games", "200", "--out", "{out}"],
      "timeout": 180
    },
    "data": {
      "command": ["{python}", "-X", "utf8", "Tools/check_game_data.py"]
    },
    "build-id": {
      "command": ["{python}", "-X", "utf8", "Tools/check_build_identity.py"]
    },
    "wiki": {
      "command": ["python", "-X", "utf8", "Tools/update_wiki.py"]
    },
    "source": {
      "command": [
        "powershell.exe",
        "-NoProfile",
        "-NonInteractive",
        "-File",
        "Validation/VerifySource.ps1"
      ]
    },
    "vision": {
      "requiresCurrentBuild": true,
      "command": [
        "Builds/Windows/ModooMarbleClassic.exe",
        "-marble-vision-check",
        "{out}",
        "-screen-fullscreen",
        "0",
        "-screen-width",
        "1440",
        "-screen-height",
        "900",
        "-logFile",
        "{out}/player.log"
      ],
      "identify": [
        "Builds/Windows/ModooMarbleClassic.exe",
        "Builds/Windows/ModooMarbleClassic_Data/Managed/Assembly-CSharp.dll"
      ],
      "result": "runtime-validation.json"
    },
    "front": {
      "requiresCurrentBuild": true,
      "command": [
        "Builds/Windows/ModooMarbleClassic.exe",
        "-marble-front-check",
        "{out}",
        "-screen-fullscreen",
        "0",
        "-screen-width",
        "1440",
        "-screen-height",
        "900",
        "-logFile",
        "{out}/player.log"
      ],
      "identify": [
        "Builds/Windows/ModooMarbleClassic.exe",
        "Builds/Windows/ModooMarbleClassic_Data/Managed/Assembly-CSharp.dll"
      ],
      "result": "runtime-validation.json"
    },
    "loop": {
      "requiresCurrentBuild": true,
      "command": [
        "Builds/Windows/ModooMarbleClassic.exe",
        "-marble-loop-preview",
        "{out}/loop",
        "-screen-fullscreen",
        "0",
        "-screen-width",
        "1440",
        "-screen-height",
        "900",
        "-logFile",
        "{out}/player.log"
      ],
      "identify": [
        "Builds/Windows/ModooMarbleClassic.exe",
        "Builds/Windows/ModooMarbleClassic_Data/Managed/Assembly-CSharp.dll"
      ],
      "result": "loop.json"
    },
    "dice": {
      "requiresCurrentBuild": true,
      "command": [
        "Builds/Windows/ModooMarbleClassic.exe",
        "-marble-dice-check",
        "{out}",
        "-screen-fullscreen",
        "0",
        "-screen-width",
        "1440",
        "-screen-height",
        "900",
        "-logFile",
        "{out}/player.log"
      ],
      "identify": [
        "Builds/Windows/ModooMarbleClassic.exe",
        "Builds/Windows/ModooMarbleClassic_Data/Managed/Assembly-CSharp.dll"
      ],
      "result": "runtime-validation.json"
    }
  }
}
